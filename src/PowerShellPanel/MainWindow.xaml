<Window x:Class="PowerShellPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PowerShellPanel.ViewModels"
        xmlns:l="clr-namespace:PowerShellPanel.Extensions"
        Title="{l:Loc App.Title}"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             Main Content: Left Panel | Right Terminal
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- ── Left: Command Panel ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18,16,18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{l:Loc Header.Title}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />

                            <Button Grid.Row="0" Grid.Column="1"
                                    Content="⚙"
                                    Width="32" Height="32"
                                    FontSize="16"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="Settings_Click"
                                    ToolTip="Settings" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{l:Loc Header.Subtitle}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </Border>

                    <!-- Quick Command Input -->
                    <Border Grid.Row="1"
                            Padding="16,12"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas, Courier New, monospace"
                                     FontSize="13"
                                     Padding="10,7"
                                     Background="{StaticResource SurfaceBrush}">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="7,0,0,7" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="{l:Loc Input.Execute}"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="{Binding CommandInput}"
                                    MinWidth="72"
                                    Height="32"
                                    Margin="0,0,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0,7,7,0" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Command Categories -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding Categories}"
                                      Margin="0,0,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ItemsControl.Template>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,0">
                                        <!-- Category Header -->
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource CategoryHeader}"
                                                   Margin="18,16,18,6"
                                                   TextOptions.TextFormattingMode="Display" />

                                        <!-- Command Cards in this category -->
                                        <ItemsControl ItemsSource="{Binding Commands}"
                                                      Margin="10,0,10,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CommandCard}"
                                                            Margin="0,0,0,6"
                                                            Command="{Binding DataContext.FillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                       Text="{Binding Name}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />

                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Description}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                                       Margin="0,3,0,0"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />

            <!-- ── Right: Terminal Panel ── -->
            <Border Grid.Column="2"
                    Background="{StaticResource TerminalBgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Terminal Header -->
                    <Border Grid.Row="0"
                            Background="#2d2d2d"
                            BorderBrush="#3e3e3e"
                            BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{l:Loc Terminal.Title}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#cccccc"
                                           FontFamily="Consolas, Courier New, monospace" />
                                <TextBlock Text="{l:Loc Terminal.Subtitle}"
                                           FontSize="11"
                                           Foreground="#808080"
                                           FontFamily="Consolas, Courier New, monospace"
                                           Margin="8,1,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{l:Loc Terminal.Clear}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="56" Height="24"
                                        FontSize="11"
                                        Padding="8,0"
                                        Click="ClearTerminal_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Terminal Output -->
                    <RichTextBox x:Name="TerminalOutputBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 Background="{StaticResource TerminalBgBrush}"
                                 Foreground="{StaticResource TerminalFgBrush}"
                                 BorderThickness="0"
                                 FontFamily="Consolas, Courier New, monospace"
                                 FontSize="13"
                                 Padding="14,10"
                                 VerticalScrollBarVisibility="Auto"
                                 IsUndoEnabled="False"
                                 PreviewMouseWheel="TerminalOutputBox_PreviewMouseWheel">
                        <RichTextBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid>
                                                <ScrollContentPresenter />
                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                           Width="6"
                                                           HorizontalAlignment="Right"
                                                           Value="{TemplateBinding VerticalOffset}"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             Status Bar
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="7" Height="7"
                             Fill="{StaticResource RunningBrush}"
                             Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           FontSize="11"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="{l:Loc Status.Bar}" />
            </Grid>
        </Border>
    </Grid>
</Window>
