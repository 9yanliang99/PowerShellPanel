<Window x:Class="PowerShellPanel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PowerShellPanel.Extensions"
        xmlns:svc="clr-namespace:PowerShellPanel.Services"
        Title="{l:Loc Settings.Title}"
        Width="420" Height="Auto"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <Window.Resources>
        <ResourceDictionary Source="../Themes/WhiteTheme.xaml" />
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#20000000" BlurRadius="20" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{l:Loc Settings.Title}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Button Grid.Column="1"
                            Content="✕"
                            Width="28" Height="28"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="18,16">

                <!-- Language -->
                <TextBlock Text="{l:Loc Settings.Language}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />

                <ComboBox x:Name="LanguageCombo"
                          FontSize="13"
                          Padding="10,6"
                          Background="{StaticResource SurfaceAltBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Flag}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{l:Loc Settings.LanguageHint}"
                           FontSize="11"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- Close Button -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="0,0,10,10"
                    Padding="14,12">
                <Button Content="OK"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="80" Height="30"
                        FontSize="12"
                        HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Border>
        </Grid>
    </Border>
</Window>
