<Window x:Class="PowerShellPanel.Views.ParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命令参数"
        Width="460" Height="Auto"
        MinWidth="380" MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <Window.Resources>
        <ResourceDictionary Source="../Themes/WhiteTheme.xaml" />
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="#20000000" BlurRadius="20" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title bar -->
                <RowDefinition Height="Auto" />
                <!-- Parameters list -->
                <RowDefinition Height="Auto" />
                <!-- Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Title Bar ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="10,10,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DialogTitle"
                                   Text="命令参数"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="CommandDesc"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✕"
                            Width="28" Height="28"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Close_Click"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- ── Parameters ── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="360">
                <StackPanel x:Name="ParametersPanel"
                            Margin="18,14" />
            </ScrollViewer>

            <!-- ── Buttons ── -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="0,0,10,10"
                    Padding="14,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="72" Height="30"
                            FontSize="12"
                            Click="Cancel_Click" />
                    <Button x:Name="OkButton"
                            Content="✓ 填入命令"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="100" Height="30"
                            FontSize="12"
                            Margin="8,0,0,0"
                            Click="Ok_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
